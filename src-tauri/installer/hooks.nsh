; SkyDek DJ branded NSIS installer language.
; Native NSIS checkbox captions can ignore SetCtlColors on Windows 11.
; Use a light page surface so they remain legible with system-rendered text.
!define MUI_BGCOLOR "F6F4FA"
!define MUI_TEXTCOLOR "1D1928"
!define MUI_HEADERIMAGE_RIGHT
!define MUI_WELCOMEPAGE_TITLE "Welcome to SkyDek DJ"
!define MUI_WELCOMEPAGE_TEXT "Created by New Ground Media.$\r$\n$\r$\nSkyDek DJ brings your music library, two decks, and Xbox controller into one DJ workspace.$\r$\n$\r$\nClick Next to begin setup."
!define MUI_FINISHPAGE_TITLE "SkyDek DJ is ready"
!define MUI_FINISHPAGE_TEXT "Installation is complete.$\r$\n$\r$\nLaunch SkyDek DJ and start mixing with your controller."
!define MUI_FINISHPAGE_RUN_TEXT "Launch SkyDek DJ"
!define MUI_BRANDINGTEXT "SkyDek DJ · New Ground Media"

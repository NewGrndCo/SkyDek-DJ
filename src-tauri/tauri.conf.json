{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyDek DJ",
  "version": "0.10.2",
  "identifier": "com.newground.skydek-dj",
  "build": {
    "beforeDevCommand": "npm run build:encoder && npm run dev",
    "beforeBuildCommand": "npm run build:encoder && npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "SkyDek DJ", "width": 1600, "height": 1000, "minWidth": 1100, "minHeight": 740, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://api.github.com https://github.com" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "publisher": "New Ground Enterprise",
    "category": "Music",
    "shortDescription": "Standalone Xbox-controlled DJ workstation",
    "resources": ["resources/licenses/*", "resources/encoder/*"],
    "windows": { "nsis": { "headerImage": "installer/header.bmp", "sidebarImage": "installer/sidebar.bmp", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico", "installMode": "currentUser", "installerHooks": "installer/hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQzFCNERCRjgyQzg0MEQKUldRTmhDejQyN1RCVVVPSzBSMElVejZOclZWdUIxTFpjMStNSmFxQlVOeEtMQkNkYmhxS0tNLzAK",
      "endpoints": ["https://github.com/NewGrndCo/SkyDek-DJ/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive", "installerArgs": ["/qn"] }
    }
  }
}
